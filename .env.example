# Only for running the collector on your own computer (npm run collect).
# On GitHub, put these in Settings → Secrets and variables → Actions instead. Never commit a real .env.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=
JOOBLE_API_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=you@example.com
JOBBANK_FEED_URL=
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
ASHBY_BOARDS=
ENABLE_SMARTRECRUITERS=false
SMARTRECRUITERS_COMPANIES=
DISABLE_ATS_DISCOVERY=false
# Daily API call budgets (spread across runs)
DAILY_CALLS_ADZUNA=240
DAILY_CALLS_JSEARCH=6
DAILY_CALLS_JOOBLE=100
DAILY_CALLS_USAJOBS=200
USE_MOCK_DATA=0
